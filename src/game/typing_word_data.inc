    {143, 0, "Job requirements: College degree,", "\265\324\307\352\327\312\326\332\316\327\312\322\312\323\331\330\367\352\256\324\321\321\312\314\312\352\311\312\314\327\312\312\360"},
    {130, 0, "Excellent communication skills,", "\260\335\310\312\321\321\312\323\331\352\310\324\322\322\332\323\316\310\306\331\316\324\323\352\330\320\316\321\321\330\360"},
