    {137, 0, "Flattery, gossip and backstabbing.", "\261\321\306\331\331\312\327\336\360\352\314\324\330\330\316\325\352\306\323\311\352\307\306\310\320\330\331\306\307\307\316\323\314\357"},
    {130, 0, "When you're walking down the street", "\302\315\312\323\352\336\324\332\353\327\312\352\334\306\321\320\316\323\314\352\311\324\334\323\352\331\315\312\352\330\331\327\312\312\331"},
    {125, 0, "And recognise someone you know,", "\254\323\311\352\327\312\310\324\314\323\316\330\312\352\330\324\322\312\324\323\312\352\336\324\332\352\320\323\324\334\360"},
    {138, 0, "It's hard to tell when to say hi...", "\264\331\353\330\352\315\306\327\311\352\331\324\352\331\312\321\321\352\334\315\312\323\352\331\324\352\330\306\336\352\315\316\357\357\357"},
    {145, 0, "Especially if you're near-sighted.", "\260\330\325\312\310\316\306\321\321\336\352\316\313\352\336\324\332\353\327\312\352\323\312\306\327\361\330\316\314\315\331\312\311\357"},
    {137, 0, "If I ever get married, I want to find", "\264\313\352\264\352\312\333\312\327\352\314\312\331\352\322\306\327\327\316\312\311\360\352\264\352\334\306\323\331\352\331\324\352\313\316\323\311"},
    {127, 0, "Someone raised by a single father.", "\276\324\322\312\324\323\312\352\327\306\316\330\312\311\352\307\336\352\306\352\330\316\323\314\321\312\352\313\306\331\315\312\327\357"},
    {130, 0, "At least that would save me the trouble", "\254\331\352\321\312\306\330\331\352\331\315\306\331\352\334\324\332\321\311\352\330\306\333\312\352\322\312\352\331\315\312\352\331\327\324\332\307\321\312"},
    {143, 0, "Of wanting my mother-in-law dead.", "\272\313\352\334\306\323\331\316\323\314\352\322\336\352\322\324\331\315\312\327\361\316\323\361\321\306\334\352\311\312\306\311\357"},
    {97, 0, "I wish the voices in my head", "\264\352\334\316\330\315\352\331\315\312\352\333\324\316\310\312\330\352\316\323\352\322\336\352\315\312\306\311"},
    {103, 0, "Would just leave me alone!", "\302\324\332\321\311\352\317\332\330\331\352\321\312\306\333\312\352\322\312\352\306\321\324\323\312\344"},
    {113, 0, "Except for the one that tells me", "\260\335\310\312\325\331\352\313\324\327\352\331\315\312\352\324\323\312\352\331\315\306\331\352\331\312\321\321\330\352\322\312"},
    {113, 0, "The answers to my history tests.", "\277\315\312\352\306\323\330\334\312\327\330\352\331\324\352\322\336\352\315\316\330\331\324\327\336\352\331\312\330\331\330\357"},
    {148, 0, "If ancient Greek gods were alive today,", "\264\313\352\306\323\310\316\312\323\331\352\262\327\312\312\320\352\314\324\311\330\352\334\312\327\312\352\306\321\316\333\312\352\331\324\311\306\336\360"},
    {120, 0, "What would they do for a living?", "\302\315\306\331\352\334\324\332\321\311\352\331\315\312\336\352\311\324\352\313\324\327\352\306\352\321\316\333\316\323\314\343"},
    {149, 0, "Maybe Hermes could be a bike messenger.", "\270\306\336\307\312\352\263\312\327\322\312\330\352\310\324\332\321\311\352\307\312\352\306\352\307\316\320\312\352\322\312\330\330\312\323\314\312\327\357"},
    {138, 0, "Maybe Zeus could be an electrician.", "\270\306\336\307\312\352\305\312\332\330\352\310\324\332\321\311\352\307\312\352\306\323\352\312\321\312\310\331\327\316\310\316\306\323\357"},
    {152, 0, "To the eyes, my family doesn't please.", "\277\324\352\331\315\312\352\312\336\312\330\360\352\322\336\352\313\306\322\316\321\336\352\311\324\312\330\323\353\331\352\325\321\312\306\330\312\357"},
    {126, 0, "We had our last reunion at the zoo.", "\302\312\352\315\306\311\352\324\332\327\352\321\306\330\331\352\327\312\332\323\316\324\323\352\306\331\352\331\315\312\352\337\324\324\357"},
    {140, 0, "The monkeys came down from the trees.", "\277\315\312\352\322\324\323\320\312\336\330\352\310\306\322\312\352\311\324\334\323\352\313\327\324\322\352\331\315\312\352\331\327\312\312\330\357"},
    {122, 0, "And I couldn't tell who was who.", "\254\323\311\352\264\352\310\324\332\321\311\323\353\331\352\331\312\321\321\352\334\315\324\352\334\306\330\352\334\315\324\357"},
    {140, 0, "I think candy sprinkles are the best!", "\264\352\331\315\316\323\320\352\310\306\323\311\336\352\330\325\327\316\323\320\321\312\330\352\306\327\312\352\331\315\312\352\307\312\330\331\344"},
    {123, 0, "I bring them to the beach with me.", "\264\352\307\327\316\323\314\352\331\315\312\322\352\331\324\352\331\315\312\352\307\312\306\310\315\352\334\316\331\315\352\322\312\357"},
    {124, 0, "I like to throw them at sunbathers.", "\264\352\321\316\320\312\352\331\324\352\331\315\327\324\334\352\331\315\312\322\352\306\331\352\330\332\323\307\306\331\315\312\327\330\357"},
    {136, 0, "Because they stick to sun tan lotion.", "\255\312\310\306\332\330\312\352\331\315\312\336\352\330\331\316\310\320\352\331\324\352\330\332\323\352\331\306\323\352\321\324\331\316\324\323\357"},
    {122, 0, "She loves me, she loves me not.", "\276\315\312\352\321\324\333\312\330\352\322\312\360\352\330\315\312\352\321\324\333\312\330\352\322\312\352\323\324\331\357"},
    {160, 0, "She loves me. Yes! She loves me not. Aww", "\276\315\312\352\321\324\333\312\330\352\322\312\357\352\304\312\330\344\352\276\315\312\352\321\324\333\312\330\352\322\312\352\323\324\331\357\352\254\334\334"},
    {137, 0, "She loves me! Yes! She loves me!", "\276\315\312\352\321\324\333\312\330\352\322\312\344\352\304\312\330\344\352\276\315\312\352\321\324\333\312\330\352\322\312\344"},
    {152, 0, "Oh, look what I've done to the spider!", "\272\315\360\352\321\324\324\320\352\334\315\306\331\352\264\353\333\312\352\311\324\323\312\352\331\324\352\331\315\312\352\330\325\316\311\312\327\344"},
    {138, 0, "I was disgusted yesterday at breakfast.", "\264\352\334\306\330\352\311\316\330\314\332\330\331\312\311\352\336\312\330\331\312\327\311\306\336\352\306\331\352\307\327\312\306\320\313\306\330\331\357"},
    {141, 0, "I was on my last piece of raisin toast,", "\264\352\334\306\330\352\324\323\352\322\336\352\321\306\330\331\352\325\316\312\310\312\352\324\313\352\327\306\316\330\316\323\352\331\324\306\330\331\360"},
    {129, 0, "When I made a startling discovery.", "\302\315\312\323\352\264\352\322\306\311\312\352\306\352\330\331\306\327\331\321\316\323\314\352\311\316\330\310\324\333\312\327\336\357"},
    {113, 0, "I wasn't eating raisin bread.", "\264\352\334\306\330\323\353\331\352\312\306\331\316\323\314\352\327\306\316\330\316\323\352\307\327\312\306\311\357"},
    {139, 0, "Have you ever thought about cloning?", "\263\306\333\312\352\336\324\332\352\312\333\312\327\352\331\315\324\332\314\315\331\352\306\307\324\332\331\352\310\321\324\323\316\323\314\343"},
    {139, 0, "Wouldn't it be neat to have a clone?", "\302\324\332\321\311\323\353\331\352\316\331\352\307\312\352\323\312\306\331\352\331\324\352\315\306\333\312\352\306\352\310\321\324\323\312\343"},
    {140, 0, "There'd only be one problem though.", "\277\315\312\327\312\353\311\352\324\323\321\336\352\307\312\352\324\323\312\352\325\327\324\307\321\312\322\352\331\315\324\332\314\315\357"},
    {128, 0, "Which one would pay for the milk?", "\302\315\316\310\315\352\324\323\312\352\334\324\332\321\311\352\325\306\336\352\313\324\327\352\331\315\312\352\322\316\321\320\343"},
    {132, 0, "Wow, look at that train over there.", "\302\324\334\360\352\321\324\324\320\352\306\331\352\331\315\306\331\352\331\327\306\316\323\352\324\333\312\327\352\331\315\312\327\312\357"},
    {154, 0, "It's coming really really fast and loud.", "\264\331\353\330\352\310\324\322\316\323\314\352\327\312\306\321\321\336\352\327\312\306\321\321\336\352\313\306\330\331\352\306\323\311\352\321\324\332\311\357"},
    {125, 0, "But my foot's stuck on the track.", "\255\332\331\352\322\336\352\313\324\324\331\353\330\352\330\331\332\310\320\352\324\323\352\331\315\312\352\331\327\306\310\320\357"},
    {152, 0, "Goodbye! Tell my mom that I loved her!", "\262\324\324\311\307\336\312\344\352\277\312\321\321\352\322\336\352\322\324\322\352\331\315\306\331\352\264\352\321\324\333\312\311\352\315\312\327\344"},
    {107, 0, "Humpty Dumpty sat on a wall,", "\263\332\322\325\331\336\352\257\332\322\325\331\336\352\330\306\331\352\324\323\352\306\352\334\306\321\321\360"},
    {117, 0, "Humpty Dumpty had a great fall.", "\263\332\322\325\331\336\352\257\332\322\325\331\336\352\315\306\311\352\306\352\314\327\312\306\331\352\313\306\321\321\357"},
    {141, 0, "All the king's horses and all of his men", "\254\321\321\352\331\315\312\352\320\316\323\314\353\330\352\315\324\327\330\312\330\352\306\323\311\352\306\321\321\352\324\313\352\315\316\330\352\322\312\323"},
    {123, 0, "Had a huge breakfast that morning.", "\263\306\311\352\306\352\315\332\314\312\352\307\327\312\306\320\313\306\330\331\352\331\315\306\331\352\322\324\327\323\316\323\314\357"},
    {157, 0, "I call for help, but they can't hear me.", "\264\352\310\306\321\321\352\313\324\327\352\315\312\321\325\360\352\307\332\331\352\331\315\312\336\352\310\306\323\353\331\352\315\312\306\327\352\322\312\357"},
    {157, 0, "I'm stuck in this box. I can't get out.", "\264\353\322\352\330\331\332\310\320\352\316\323\352\331\315\316\330\352\307\324\335\357\352\264\352\310\306\323\353\331\352\314\312\331\352\324\332\331\357"},
    {123, 0, "I'm starting to wish that I didn't", "\264\353\322\352\330\331\306\327\331\316\323\314\352\331\324\352\334\316\330\315\352\331\315\306\331\352\264\352\311\316\311\323\353\331"},
    {137, 0, "Quit mime school after the first day.", "\274\332\316\331\352\322\316\322\312\352\330\310\315\324\324\321\352\306\313\331\312\327\352\331\315\312\352\313\316\327\330\331\352\311\306\336\357"},
    {92, 0, "I'm in a bit of a hurry,", "\264\353\322\352\316\323\352\306\352\307\316\331\352\324\313\352\306\352\315\332\327\327\336\360"},
    {89, 0, "I had too much iced tea.", "\264\352\315\306\311\352\331\324\324\352\322\332\310\315\352\316\310\312\311\352\331\312\306\357"},
    {92, 0, "Now it's time to worry,", "\271\324\334\352\316\331\353\330\352\331\316\322\312\352\331\324\352\334\324\327\327\336\360"},
    {110, 0, "Because I really have to pee.", "\255\312\310\306\332\330\312\352\264\352\327\312\306\321\321\336\352\315\306\333\312\352\331\324\352\325\312\312\357"},
    {146, 0, "If it isn't one thing, it's another.", "\264\313\352\316\331\352\316\330\323\353\331\352\324\323\312\352\331\315\316\323\314\360\352\316\331\353\330\352\306\323\324\331\315\312\327\357"},
    {140, 0, "If it isn't your house, it's mine.", "\264\313\352\316\331\352\316\330\323\353\331\352\336\324\332\327\352\315\324\332\330\312\360\352\316\331\353\330\352\322\316\323\312\357"},
    {129, 0, "If I'm not picking my own nose,", "\264\313\352\264\353\322\352\323\324\331\352\325\316\310\320\316\323\314\352\322\336\352\324\334\323\352\323\324\330\312\360"},
    {142, 0, "Then I must be picking yours. Yuck.", "\277\315\312\323\352\264\352\322\332\330\331\352\307\312\352\325\316\310\320\316\323\314\352\336\324\332\327\330\357\352\304\332\310\320\357"},
    {117, 0, "If at first you don't succeed,", "\264\313\352\306\331\352\313\316\327\330\331\352\336\324\332\352\311\324\323\353\331\352\330\332\310\310\312\312\311\360"},
    {119, 0, "Dust yourself off and try again.", "\257\332\330\331\352\336\324\332\327\330\312\321\313\352\324\313\313\352\306\323\311\352\331\327\336\352\306\314\306\316\323\357"},
    {140, 0, "If you still don't succeed, then you", "\264\313\352\336\324\332\352\330\331\316\321\321\352\311\324\323\353\331\352\330\332\310\310\312\312\311\360\352\331\315\312\323\352\336\324\332"},
    {122, 0, "Might want to try something else.", "\270\316\314\315\331\352\334\306\323\331\352\331\324\352\331\327\336\352\330\324\322\312\331\315\316\323\314\352\312\321\330\312\357"},
    {117, 0, "I used to not be afraid of rice.", "\264\352\332\330\312\311\352\331\324\352\323\324\331\352\307\312\352\306\313\327\306\316\311\352\324\313\352\327\316\310\312\357"},
    {132, 0, "But one day I was eating a huge bowl.", "\255\332\331\352\324\323\312\352\311\306\336\352\264\352\334\306\330\352\312\306\331\316\323\314\352\306\352\315\332\314\312\352\307\324\334\321\357"},
    {123, 0, "I was almost done with my rice when", "\264\352\334\306\330\352\306\321\322\324\330\331\352\311\324\323\312\352\334\316\331\315\352\322\336\352\327\316\310\312\352\334\315\312\323"},
    {106, 0, "The last piece crawled away.", "\277\315\312\352\321\306\330\331\352\325\316\312\310\312\352\310\327\306\334\321\312\311\352\306\334\306\336\357"},
    {125, 0, "So many people are so very ugly.", "\276\324\352\322\306\323\336\352\325\312\324\325\321\312\352\306\327\312\352\330\324\352\333\312\327\336\352\332\314\321\336\357"},
    {137, 0, "I'm tired of looking at all of them.", "\264\353\322\352\331\316\327\312\311\352\324\313\352\321\324\324\320\316\323\314\352\306\331\352\306\321\321\352\324\313\352\331\315\312\322\357"},
    {144, 0, "Maybe I should look away, but sometimes", "\270\306\336\307\312\352\264\352\330\315\324\332\321\311\352\321\324\324\320\352\306\334\306\336\360\352\307\332\331\352\330\324\322\312\331\316\322\312\330"},
    {154, 0, "It's very difficult. They're so ugly.", "\264\331\353\330\352\333\312\327\336\352\311\316\313\313\316\310\332\321\331\357\352\277\315\312\336\353\327\312\352\330\324\352\332\314\321\336\357"},
    {150, 0, "Sometimes the wind takes me by surprise.", "\276\324\322\312\331\316\322\312\330\352\331\315\312\352\334\316\323\311\352\331\306\320\312\330\352\322\312\352\307\336\352\330\332\327\325\327\316\330\312\357"},
    {130, 0, "At those times I push my skirt down.", "\254\331\352\331\315\324\330\312\352\331\316\322\312\330\352\264\352\325\332\330\315\352\322\336\352\330\320\316\327\331\352\311\324\334\323\357"},
    {123, 0, "My father really hates my dresses,", "\270\336\352\313\306\331\315\312\327\352\327\312\306\321\321\336\352\315\306\331\312\330\352\322\336\352\311\327\312\330\330\312\330\360"},
    {140, 0, "But only because he wears nicer ones.", "\255\332\331\352\324\323\321\336\352\307\312\310\306\332\330\312\352\315\312\352\334\312\306\327\330\352\323\316\310\312\327\352\324\323\312\330\357"},
    {144, 0, "Wild monkeys take care of their young.", "\302\316\321\311\352\322\324\323\320\312\336\330\352\331\306\320\312\352\310\306\327\312\352\324\313\352\331\315\312\316\327\352\336\324\332\323\314\357"},
    {119, 0, "But so do domesticated monkeys.", "\255\332\331\352\330\324\352\311\324\352\311\324\322\312\330\331\316\310\306\331\312\311\352\322\324\323\320\312\336\330\357"},
    {152, 0, "I'm not sure where I'm going with this,", "\264\353\322\352\323\324\331\352\330\332\327\312\352\334\315\312\327\312\352\264\353\322\352\314\324\316\323\314\352\334\316\331\315\352\331\315\316\330\360"},
    {147, 0, "But I'm starting to wish I was a monkey.", "\255\332\331\352\264\353\322\352\330\331\306\327\331\316\323\314\352\331\324\352\334\316\330\315\352\264\352\334\306\330\352\306\352\322\324\323\320\312\336\357"},
    {137, 0, "How strange to run into an old flame.", "\263\324\334\352\330\331\327\306\323\314\312\352\331\324\352\327\332\323\352\316\323\331\324\352\306\323\352\324\321\311\352\313\321\306\322\312\357"},
    {107, 0, "You noticed changed things,", "\304\324\332\352\323\324\331\316\310\312\311\352\310\315\306\323\314\312\311\352\331\315\316\323\314\330\360"},
    {104, 0, "Such as their shape and hair,", "\276\332\310\315\352\306\330\352\331\315\312\316\327\352\330\315\306\325\312\352\306\323\311\352\315\306\316\327\360"},
    {128, 0, "And that they're no longer naked.", "\254\323\311\352\331\315\306\331\352\331\315\312\336\353\327\312\352\323\324\352\321\324\323\314\312\327\352\323\306\320\312\311\357"},
    {130, 0, "As much as I hate saying good-bye,", "\254\330\352\322\332\310\315\352\306\330\352\264\352\315\306\331\312\352\330\306\336\316\323\314\352\314\324\324\311\361\307\336\312\360"},
    {135, 0, "I think I'll have to sometime soon.", "\264\352\331\315\316\323\320\352\264\353\321\321\352\315\306\333\312\352\331\324\352\330\324\322\312\331\316\322\312\352\330\324\324\323\357"},
    {147, 0, "You're just not what I'm looking for.", "\304\324\332\353\327\312\352\317\332\330\331\352\323\324\331\352\334\315\306\331\352\264\353\322\352\321\324\324\320\316\323\314\352\313\324\327\357"},
    {133, 0, "I like my men with all their brains.", "\264\352\321\316\320\312\352\322\336\352\322\312\323\352\334\316\331\315\352\306\321\321\352\331\315\312\316\327\352\307\327\306\316\323\330\357"},
