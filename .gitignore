# Game material - never commit
/original/*
/game/*
*.iso
*.bin
*.cue
*.mdf
*.mds

# Ghidra project database
/ghidra/*

# Build output
build/
/build-*/
out/
*.obj
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.exp

# Tooling
.vs/
__pycache__/
*.pyc
!/original/.gitkeep
!/game/.gitkeep
!/ghidra/.gitkeep

# agent worktrees (Claude Code)
.claude/worktrees/

# Remaster asset pack (derived from the game's data; tools/remaster.py)
remaster/

# User-authored maps (the reusable starter is generated by tools/map_editor/map_format.py)
custom_maps/


# Local settings, credentials and generated packages
hotd2re_settings.ini
hotd2re_wii.ini
hotd2re_*.bin
*.log
*.dmp
*.zip
*.7z
.env
.env.*
!.env.example
*.pem
*.key
.mcp.json
.claude/
